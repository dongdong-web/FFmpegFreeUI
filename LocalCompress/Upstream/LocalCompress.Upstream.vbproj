<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LocalCompress.Upstream</RootNamespace>
    <DefineConstants>LOCALCOMPRESS_HEADLESS=True</DefineConstants>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设数据_v6.vb" Link="Shared/预设数据_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设通用函数_v6.vb" Link="Shared/预设通用函数_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设存储_v6.vb" Link="Shared/预设存储_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设滤镜排序_v6.vb" Link="Shared/预设滤镜排序_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设命令行核心_v6.vb" Link="Shared/预设命令行核心_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设命令行滤镜图_v6.vb" Link="Shared/预设命令行滤镜图_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/预设系统/预设区段_*.vb" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../FFmpegFreeUI/功能/视频编码器数据库_v6.vb" Link="Shared/视频编码器数据库_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/音频编码器数据库_v6.vb" Link="Shared/音频编码器数据库_v6.vb" />
    <Compile Include="../../FFmpegFreeUI/功能/启动参数响应_v6.vb" Link="Shared/启动参数响应_v6.vb" />
  </ItemGroup>
</Project>
